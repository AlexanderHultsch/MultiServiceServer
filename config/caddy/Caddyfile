# Caddy as reverse proxy behind the Cloudflare Tunnel.
#
# HOW ROUTING WORKS HERE:
# cloudflared forwards EVERY public hostname to caddy:80 (in the Cloudflare
# dashboard, all Public Hostnames are set to the service http://caddy:80).
# Caddy then decides which site to serve based on the Host header.
#
# {$DOMAIN} is replaced on read-in by the value of the DOMAIN environment
# variable (comes from .env via docker-compose.yml), e.g. your-domain.de.
#
# ADDING A NEW SITE:
#  - Static: create a folder under sites/<name>/, add an @<name> block
#    below, then `docker compose restart caddy`.
#  - Dynamic: create an app under apps/<name>/, add it as a service in
#    docker-compose.yml, add a reverse_proxy block below.
#  - In BOTH cases, additionally create a Public Hostname
#    <name>.<DOMAIN> -> http://caddy:80 in the Cloudflare dashboard (see README).

{
	# Behind the Cloudflare Tunnel: Cloudflare handles HTTPS externally,
	# Caddy only serves HTTP internally on port 80. So automatic HTTPS is off.
	auto_https off
	# Admin API off (no reload needed - config changes via
	# `docker compose restart caddy`, static files are served live).
	admin off
}

:80 {
	# Security headers for all sites
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	encode gzip zstd

	# --- Main site (apex domain), static: sites/main/ ---
	@main host {$DOMAIN} www.{$DOMAIN}
	handle @main {
		root * /srv/main
		file_server
	}

	# --- Example static subpage: beispiel.<DOMAIN> -> sites/beispiel/ ---
	# (Template: copy, rename, create your own folder under sites/.)
	@beispiel host beispiel.{$DOMAIN}
	handle @beispiel {
		root * /srv/beispiel
		file_server
	}

	# --- Example dynamic app: app.<DOMAIN> -> container app-example ---
	@app host app.{$DOMAIN}
	handle @app {
		reverse_proxy app-example:3000
	}

	# --- Wine Caching (dynamic app): winecashing.<DOMAIN> -> container winecashing ---
	@winecashing host winecashing.{$DOMAIN}
	handle @winecashing {
		reverse_proxy winecashing:3000
	}

	# --- GinPerium (dynamic app): ginperium.<DOMAIN> -> container ginperium ---
	@ginperium host ginperium.{$DOMAIN}
	handle @ginperium {
		reverse_proxy ginperium:3000
	}

	# --- Tipsy Trails (dynamic app): tipsytrails.<DOMAIN> -> container tipsy-trails ---
	@tipsy-trails host tipsytrails.{$DOMAIN}
	handle @tipsy-trails {
		reverse_proxy tipsy-trails:3000
	}

	# --- Bring2Bring! (dynamic app): bring2bring.<DOMAIN> -> container bring2bring ---
	# WARNING: /r/* is the deliberately PUBLIC share page - Bring! fetches this
	# URL from its own servers with a non-browser user agent. If this host ever
	# ends up behind Cloudflare bot-fighting or an Access rule, every Bring!
	# import breaks silently, while the page keeps looking completely normal
	# in the browser.
	@bring2bring host bring2bring.{$DOMAIN}
	handle @bring2bring {
		# cloudflared speaks plain HTTP with caddy:80, so Caddy sets
		# X-Forwarded-Proto: http on its own. Express-session then silently
		# refuses the secure session cookie (only a debug() call,
		# no error message): the login succeeds, the cookie is missing, the
		# user lands back on /login. Externally the scheme is always
		# https - Cloudflare terminates TLS - so that's what we tell it.
		reverse_proxy bring2bring:3000 {
			header_up X-Forwarded-Proto https
		}
	}

	# Unknown hostname -> 404
	handle {
		respond "Not found" 404
	}
}

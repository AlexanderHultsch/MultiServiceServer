# Easiest way: do NOT fill this in by hand, use the assistant instead:
#   bash scripts/setup-env.sh
# Alternative: copy to ".env" and adjust the values. NEVER commit ".env".

# Timezone for all containers
TZ=Europe/Berlin

# Home network CIDR for firewall rules (adjust to your own LAN!)
LAN_SUBNET=192.168.1.0/24

# Static IP of the Pi on the LAN (set up a DHCP reservation on the router)
PI_STATIC_IP=192.168.1.10

# Host ports (LAN-only binding, see docker-compose.yml)
PORT_PIHOLE_UI=8080
PORT_DNS=53
PORT_UPTIME=3001

# Public domain of the website (managed via Cloudflare)
DOMAIN=<<DOMAIN>>

# Pi-hole admin password (secret)
PIHOLE_PASSWORD=<<PIHOLE_PASSWORD>>

# Cloudflare tunnel token from the Zero Trust dashboard (secret)
CLOUDFLARE_TUNNEL_TOKEN=<<CLOUDFLARE_TUNNEL_TOKEN>>

# --- Backup (SPEC section 8) ---

# rclone remote target for encrypted backups (run rclone config first)
BACKUP_REMOTE=onedrive:PiBackups

# Retention: number of weekly archives to keep (12 is about three months).
# Older archives are deleted.
BACKUP_RETENTION_COUNT=12

# Optional: push URL of an Uptime Kuma monitor of type Push. The backup pings
# it on success and on failure. If the backup never runs at all, the
# monitor's own heartbeat interval raises the alarm - about 8 days suits a
# weekly backup. Leave empty to disable the notification.
BACKUP_HEARTBEAT_URL=

# age public key (recipient) for encrypting the backups.
# Generate with: age-keygen -o ~/.config/age/pi-server.txt
# It prints "Public key: age1..." -> enter that here.
# The PRIVATE key stays outside Git/backup, in a secure location!
AGE_RECIPIENT=<<AGE_RECIPIENT_PUBLIC_KEY>>
